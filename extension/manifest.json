{
  "manifest_version": 3,
  "name": "Gemini Extension Agent POC",
  "version": "0.12.1",
  "description": "Runs the Google-to-Gemini browser agent inside an isolated InPrivate window using a one-shot local credential bridge.",
  "key": "",
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "webNavigation",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://accounts.google.com/*",
    "https://identitytoolkit.googleapis.com/*"
  ],
  "incognito": "spanning",
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://poc-after-sso-login-gemini.web.app/*"
    ]
  }
}
