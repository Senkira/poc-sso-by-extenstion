{
  "manifest_version": 3,
  "name": "Gemini SSO Launcher POC",
  "version": "0.1.0",
  "description": "Opens Gemini from the approved Firebase-hosted launcher and reports truthful tab lifecycle evidence.",
  "key": "",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://accounts.google.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://poc-after-sso-login-gemini.web.app/*"
    ]
  },
  "incognito": "not_allowed"
}

