{
  "manifest_version": 3,
  "name": "Gemini Secretless Launcher POC",
  "version": "0.4.1",
  "description": "Launches the approved Google-to-Gemini flow while authentication remains entirely with Google, the browser, or an external IdP.",
  "key": "",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "scripting"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://accounts.google.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://poc-after-sso-login-gemini.web.app/*"
    ]
  },
  "incognito": "not_allowed"
}
